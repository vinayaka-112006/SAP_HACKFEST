{
  "requires": {
    "db": {
      "kind": "sqlite"
    },
    "queue": false,
    "[test]": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      }
    },
    "[production]": {
      "db": {
        "kind": "sqlite",
        "impl": "@cap-js/sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "kind": "xsuaa"
      }
    },
    "[development]": {
      "db": {
        "credentials": {
          "url": "db.sqlite"
        }
      }
    }
  },
  "server": "./srv/server.js",
  "build": {
    "tasks": [
      {
        "for": "nodejs",
        "src": "srv",
        "options": {
          "model": [
            "db",
            "srv"
          ]
        }
      }
    ]
  }
}
