# SQLite is the only application database. Keep provider keys private.
DATABASE_MODE=sqlite
SQLITE_FILE=db.sqlite
PORT=4004
V2_WORKFLOW_ENABLED=true
V22_WORKFLOW_ENABLED=true
# Development only; never enable synthetic seeding in production.
V22_SYNTHETIC_FIXTURES=true
AUTH_MODE=header
ENFORCE_APPROVALS=true
ALLOW_UNAPPROVED_MOCKS=false
GROQ_API_KEY=
SARVAM_API_KEY=
