# Copy to backend/.env; never commit real credentials.
DATABASE_MODE=sqlite
HANA_CONNECTION=direct
HANA_SQL_ENDPOINT=your-instance.hana.hanacloud.ondemand.com:443
HANA_USER=your_database_username
HANA_PASSWORD=your_database_password
HANA_SCHEMA=your_authorized_schema
HANA_ENCRYPT=true
HANA_VALIDATE_CERTIFICATE=true
PORT=4004

# Set only after the schema owner confirms exclusive ToolSathi assignment.
# HANA_TARGET_CONFIRMED=TOOLSATHI
# A separate dedicated test destination is required for test:hana.
# HANA_TEST_SCHEMA=TOOLSATHI_TEST
